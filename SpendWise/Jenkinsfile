
pipeline {
    agent any

    options {
        timestamps()
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    environment {
        PYTHONUNBUFFERED = '1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'SpendWise source code checked out from GitHub'
            }
        }

        stage('Backend Setup') {
            steps {
                dir('SpendWise/backend') {
                    sh 'python3 --version'
                    sh 'python3 -m venv .venv-ci'
                    sh '.venv-ci/bin/python -m pip install --upgrade pip'
                    sh '.venv-ci/bin/python -m pip install -r requirements.txt'
                }
            }
        }

        stage('Backend Validation') {
            steps {
                dir('SpendWise/backend') {
                    sh '.venv-ci/bin/python -m compileall -q app'
                    echo 'Backend Python syntax validation successful'
                }
            }
        }

        stage('Frontend Setup') {
            steps {
                dir('SpendWise/frontend') {
                    sh 'node --version'
                    sh 'npm --version'
                    sh 'npm ci'
                }
            }
        }

        stage('Frontend Build') {
            steps {
                dir('SpendWise/frontend') {
                    sh 'npm run build'
                    echo 'Frontend build successful'
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                dir('SpendWise') {
                    withCredentials([file(credentialsId: 'SpendWise-env', variable: 'SPENDWISE_ENV_FILE')]) {
                        sh 'docker compose --env-file "$SPENDWISE_ENV_FILE" config --quiet'
                        sh 'docker compose --env-file "$SPENDWISE_ENV_FILE" build backend frontend'
                        echo 'Docker images built successfully'
                    }
                }
            }
        }
        stage('Deploy SpendWise') {
            steps {
                dir('SpendWise') {
                    withCredentials([file(credentialsId: 'SpendWise-env', variable: 'SPENDWISE_ENV_FILE')]) {
                        sh '''
                            docker compose --env-file "$SPENDWISE_ENV_FILE" config --quiet
                            docker compose --env-file "$SPENDWISE_ENV_FILE" up --detach --no-build --wait --wait-timeout 180
                            docker compose --env-file "$SPENDWISE_ENV_FILE" ps
                        '''
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('SpendWise') {
                    withCredentials([file(credentialsId: 'SpendWise-env', variable: 'SPENDWISE_ENV_FILE')]) {
                        sh '''
                            set -eu
                            docker compose --env-file "$SPENDWISE_ENV_FILE" config --quiet
                            docker compose --env-file "$SPENDWISE_ENV_FILE" up --detach --no-build --wait --wait-timeout 180
                            docker compose --env-file "$SPENDWISE_ENV_FILE" ps
                        '''
                    }
                }
            }
            post {
                success {
                    echo 'SpendWise deployment succeeded; db, backend, and frontend are ready.'
                }
                failure {
                    echo 'SpendWise deployment failed. Existing PostgreSQL volume was not removed; check Console Output.'
                }
            }
        }
    }

    post {
        success {
            echo 'SpendWise CI/CD pipeline completed successfully.'
        }
        failure {
            echo 'SpendWise CI/CD pipeline failed. Deployment runs only after validation and image build succeed.'
        }
    }
}
